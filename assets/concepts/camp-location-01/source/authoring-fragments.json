{
  "campHeaderHtml": "<div layer-name=\"Заголовок локации\" style=\"display:flex;flex-direction:column;width:1512px;gap:10px;flex-shrink:0;\">\n  <div style=\"display:flex;justify-content:space-between;align-items:center;width:1512px;\">\n    <div style=\"font-family:'Golos Text';font-size:16px;line-height:22px;font-weight:600;letter-spacing:0.12em;color:#56684F;\">ЛОКАЦИЯ 01 / ОТКРЫТЫЙ МИР</div>\n    <div style=\"font-family:'Golos Text';font-size:16px;line-height:22px;font-weight:500;color:#56684F;\">БЕЗОПАСНАЯ СТОЯНКА</div>\n  </div>\n  <div style=\"font-family:'Oswald';font-size:64px;line-height:76px;font-weight:600;letter-spacing:-0.02em;color:#242F2B;\">ЛАГЕРЬ СТРАННИКОВ</div>\n  <div style=\"font-family:'Golos Text';font-size:20px;line-height:28px;font-weight:400;color:#4B584E;\">Тёплый огонь перед дорогой · тихая поляна у монастырских предгорий</div>\n</div>",
  "campSceneHtml": "<div layer-name=\"Панорама лагеря\" style=\"display:flex;position:relative;width:1512px;height:852px;flex-shrink:0;overflow:hidden;\">\n  <img layer-name=\"Лагерь — итоговая иллюстрация\" src=\"paper-asset:///Users/kirchik/Documents/project/diablo-like-game/assets/concepts/camp-location-01/camp-scene.png\" style=\"width:1512px;height:852px;object-fit:contain;image-rendering:pixelated;\" />\n</div>",
  "campLegendShellHtml": "<div layer-name=\"Легенда локации\" style=\"display:flex;flex-direction:row;width:1512px;gap:36px;align-items:flex-start;flex-shrink:0;\"></div>",
  "campLegend1Html": "<div layer-name=\"Свободная поляна\" style=\"display:flex;flex-direction:column;width:480px;gap:8px;flex-shrink:0;\">\n  <div style=\"font-family:'Oswald';font-size:28px;line-height:36px;font-weight:500;color:#242F2B;\">ПОЛЯНА ДЛЯ ПЕРЕДЫШКИ</div>\n  <div style=\"font-family:'Golos Text';font-size:18px;line-height:27px;font-weight:400;color:#4B584E;\">Место начала пути. Огонь и припасы — по разные стороны от героя; середина остаётся свободной.</div>\n</div>",
  "campLegend2Html": "<div layer-name=\"Парные навесы\" style=\"display:flex;flex-direction:column;width:480px;gap:8px;flex-shrink:0;\">\n  <div style=\"font-family:'Oswald';font-size:28px;line-height:36px;font-weight:500;color:#242F2B;\">НОЧЛЕГ ПО ДВУМ СТОРОНАМ</div>\n  <div style=\"font-family:'Golos Text';font-size:18px;line-height:27px;font-weight:400;color:#4B584E;\">Два полотняных навеса, спальники и дорожный скарб. Низкие уступы и заросли обрамляют стоянку.</div>\n</div>",
  "campLegend3Html": "<div layer-name=\"Дорога к монастырю\" style=\"display:flex;flex-direction:column;width:480px;gap:8px;flex-shrink:0;\">\n  <div style=\"font-family:'Oswald';font-size:28px;line-height:36px;font-weight:500;color:#242F2B;\">ОДИН ПУТЬ ДАЛЬШЕ</div>\n  <div style=\"font-family:'Golos Text';font-size:18px;line-height:27px;font-weight:400;color:#4B584E;\">Светлая тропа проходит между двумя каменными знаками и уходит к монастырской дороге.</div>\n</div>"
}

