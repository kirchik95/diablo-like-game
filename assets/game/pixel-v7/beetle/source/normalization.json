  "gameplayNotes": {
    "idle": "Loop while idle.",
    "walk": "Loop; advance by travelled distance like hound/wraith run.",
    "windup": "Spread keys 0-4 over the gameplay windup. Keys 3-4 hold the rear-high pose with magenta seams: the readable telegraph.",
    "slam": "Key 1 is ground contact. Fire damage and impact effects from gameplay timing, not from the animation.",
    "recover": "Seams cool from dim to none; key 2 is the normal stance.",
    "hurt": "One-shot reaction; key 3 dims the eye.",
    "stunned": "Loop while stunned/flipped. The coral weak spot on the soft underside appears only in this clip.",
    "death": "One-shot then hold key 5 (corpse shell). Eyes go out on keys 4-5.",
    "block": "Optional guard flinch (shell forward). Hold key 1; runtime spawns sparks."
  },
